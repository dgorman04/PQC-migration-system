# Copy to .env and adjust. Loaded by docker-compose.yml.
# Never commit the real .env.

# --- Postgres (pqc-core-api + pgvector for RAG) ---
POSTGRES_USER=pqc
POSTGRES_PASSWORD=pqc_dev_only_change_me
POSTGRES_DB=pqc
POSTGRES_PORT=5432

# --- Neo4j ---
NEO4J_AUTH=neo4j/pqc_dev_only_change_me
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# --- MLflow ---
MLFLOW_PORT=5000
# SQLite backend + local ./infra/.mlflow-data volume — no S3/MinIO for the MVP.
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=pqc-quantum-risk

# --- Core API (once built, §7.3) ---
PQC_API_TOKEN=dev_only_shared_token
PQC_CORE_API_PORT=8080

# --- Inference service (once built, §7.6) ---
PQC_INFERENCE_PORT=8081
PQC_MODEL_ALIAS=champion

# --- ai-api / agent (once built, §7.10) ---
PQC_AI_API_PORT=8082
ANTHROPIC_API_KEY=

# --- KFP (training pipelines, §7.5) ---
KFP_HOST=http://localhost:8888
